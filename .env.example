# =====================================================================================
# Variáveis do docker-compose do SonarQube (modelo SEM valores reais).
# Recomendado: ./scripts/generate-env.sh  (gera o .env com segredos aleatórios)
# O .env NUNCA é versionado (está no .gitignore). Este arquivo não pode conter valores reais.
# =====================================================================================

# Senha do usuário "sonarqube" do PostgreSQL (rede interna).
POSTGRES_PASSWORD=

# Senha do usuário "admin" da UI/API. O provisionamento troca a senha padrão por esta.
# O SonarQube exige ao menos 12 caracteres com maiúscula, minúscula, dígito e caractere especial.
SONAR_ADMIN_PASSWORD=

# Passcode do monitoramento (header X-Sonar-Passcode), usado pelo healthcheck do container.
SONAR_SYSTEM_PASSCODE=
